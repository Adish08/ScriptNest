// ==UserScript==
// @name         Universal Unblock: Copy, Paste & Right Click
// @namespace    https://github.com/adish
// @version      1.0.0
// @description  Prevents websites from disabling copy, paste, cut, text selection, and right-click context menus. Replaces "Don't F*** With Paste" and "Absolute Enable Right Click".
// @match        *://*/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(function () {
  'use strict';
  const blockedEvents = ['copy', 'cut', 'paste', 'contextmenu', 'selectstart', 'dragstart'];
  const allowAction = (e) => { e.stopImmediatePropagation(); return true; };

  blockedEvents.forEach((eventType) => {
    window.addEventListener(eventType, allowAction, true);
    document.addEventListener(eventType, allowAction, true);
  });

  const unblockStyles = () => {
    const style = document.createElement('style');
    style.id = 'unblock-copy-paste-styles';
    style.textContent = `
      * { -webkit-user-select: auto !important; user-select: auto !important; }
      input, textarea, [contenteditable="true"] { -webkit-user-select: text !important; user-select: text !important; }
    `;
    (document.head || document.documentElement).appendChild(style);
  };

  if (document.head || document.documentElement) unblockStyles();
  else document.addEventListener('DOMContentLoaded', unblockStyles);
})();
